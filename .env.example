# Frontend build-time environment variables (read by Parcel).
# Copy to `.env` (or `.env.production` / `.env.development`) and adjust.
# These are inlined into the client bundle at build time, so only put
# PUBLIC values here. Backend secrets belong in api/local.settings.json.

# Public Cloudflare Turnstile site key. If unset, the default widget key in
# src/models/config.js is used.
TURNSTILE_SITE_KEY=0x4AAAAAAA2IUz1CU0EU3E-O
