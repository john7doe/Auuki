{
    "$schema": "https://json.schemastore.org/staticwebapp.config.json",
    "platform": {
        "apiRuntime": "node:20"
    },
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/api/*",
            "/images/*",
            "/css/*",
            "/*.{js,css,json,png,jpg,jpeg,gif,svg,ico,webmanifest,txt,xml,woff,woff2,fit,zwo}"
        ]
    }
}
